# Copy to .env.local for local work, or set the same keys on Vercel.

# Public site
NEXT_PUBLIC_COMPANY_NAME="PAK Precision Tools"
# Production must be the live origin so sitemap/robots absolute URLs are correct.
NEXT_PUBLIC_SITE_URL=https://pakprecisiontools.pk
NEXT_PUBLIC_CONTACT_EMAIL=sales@pakprecisiontools.pk
NEXT_PUBLIC_WHATSAPP_NUMBER=923211715253
NEXT_PUBLIC_WHATSAPP_DISPLAY="+92 321 1715253"
NEXT_PUBLIC_LANDLINE="+92 321 1715253"
NEXT_PUBLIC_ADDRESS="Shop 29, Bank Arcade, Serai Road|Karachi, Pakistan"
NEXT_PUBLIC_MAP_URL="https://www.google.com/maps/search/?api=1&query=Shop+29+Bank+Arcade+Serai+Road+Karachi+Pakistan"

# Optional email (comma-separated). Inbox delivery does not need this.
SALES_EMAIL=sales@pakprecisiontools.pk

# Laravel dashboard — must match dashboard/.env SITE_KEY_PKPT
# Also used to load products added in the dashboard (GET .../api/v1/catalog/products).
INBOX_URL=https://dashboard.homesupplies.ae/api/v1/submissions
INBOX_SITE_KEY=site_pkpt_local_dev_key_change_me
